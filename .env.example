# =============================================================
# ENQUIVO — Environment Variable Reference
# Copy this file to .env.local and fill in real values.
# NEVER commit .env, .env.local, or any file containing real secrets.
# =============================================================

# --- Database (Neon PostgreSQL) ---
# Application Traffic: Pooled connection string (host includes -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Schema Migrations: Direct connection string (host does NOT include -pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-generated-secret"
# Full URL of your app (no trailing slash)
AUTH_URL="http://localhost:3000"

# --- Google Gemini AI ---
# Get from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-google-gemini-api-key"

# --- Inngest (Background Jobs) ---
# Get from Inngest Cloud dashboard: https://app.inngest.com
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="your-inngest-signing-key"

# --- Application ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Kolkata"

# --- Node Environment ---
NODE_ENV="development"

